[Unit]
Description=Security Center local diagnostic telemetry
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/lib/security-center/telemetry_worker.py
Environment=PYTHONDONTWRITEBYTECODE=1
DynamicUser=yes
StateDirectory=security-center-telemetry
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=30
TimeoutStopSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryHigh=24M
MemoryMax=40M
TasksMax=8
CPUQuota=5%

[Install]
WantedBy=multi-user.target
